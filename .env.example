# EduShell OS — Optional AI (DO NOT commit real keys)

# AI Mode: offline | groq | ollama
# offline = works for all students, no key needed (default)
AI_MODE=offline

# Groq free tier — get key at https://console.groq.com
# Enter in Settings UI (stored in browser localStorage only)
GROQ_API_KEY=

# Ollama local — run: ollama run llama3.2
OLLAMA_URL=http://localhost:11434
